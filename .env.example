APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Academy learner SPA (used for Path B links in certificate emails)
FRONTEND_URL=https://academy.agrisiti.com

# Agrisiti Finance (Lend) — Earn→Fund CTAs + Learn→Fund service auth
FINANCE_URL=https://lend.agrisiti.com
FINANCE_API_URL=https://lend-api.agrisiti.com
# Shared secret for Finance → Academy internal APIs (must match Finance ACADEMY_SERVICE_KEY)
ACADEMY_INTERNAL_API_KEY=change-me-shared-secret
# Graduate loan eligibility notifications (SMS/email after certificate)
FINANCE_GRADUATE_FUNDING_ENABLED=true
FINANCE_GRADUATE_ELIGIBLE_LOAN_AMOUNT=7500000

# VR Studio sibling (Option B — WebXR authoring + player)
VR_STUDIO_URL=https://agrisiti-vr-studio.netlify.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# VR Studio AI (Amazon Bedrock). Use a US inference profile ID (us.anthropic.…), not the bare model id.
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Optional upgrades: us.anthropic.claude-sonnet-4-20250514-v1:0  or  us.anthropic.claude-opus-4-20250514-v1:0
AWS_BEDROCK_MAX_TOKENS=4096

VITE_APP_NAME="${APP_NAME}"

SENDER_API_KEY=
SENDER_API_HOST=api.sender.net
SENDER_API_PROTO=https
SENDER_API_PATH=v2
SENDER_TIMEOUT=30
SENDER_DEBUG=false


BROADCAST_DRIVER=pusher
PUSHER_APP_ID=your_app_id
PUSHER_APP_KEY=your_app_key
PUSHER_APP_SECRET=your_app_secret
PUSHER_APP_CLUSTER=mt1

# Laravel Reverb (WebSocket server for chatbot real-time streaming)
# These lines must exist here even as placeholders — the deploy script's
# update_env() only replaces an existing "KEY=..." line via sed, it does not
# append missing ones, so a key absent from this file can never actually get
# written into the deployed .env no matter what the CI/CD script sets it to.
REVERB_APP_ID=agrisiti-chatbot
REVERB_APP_KEY=agrisiti-chatbot-key
REVERB_APP_SECRET=agrisiti-chatbot-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Swagger / OpenAPI Documentation
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_CONST_HOST=https://academy-backends.agrisiti.com
L5_FORMAT_TO_USE_FOR_DOCS=json
L5_SWAGGER_OPEN_API_SPEC_VERSION=3.0.0

# Claude AI (Chatbot)
ANTHROPIC_API_KEY=

# Africa's Talking (USSD + SMS for Nigeria)
AT_API_KEY=
AT_USERNAME=sandbox
AT_HASH_KEY=
